<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | PorQuéSucede</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="https://porquesucede.com{{ page.url }}">
  <link rel="stylesheet" href="/styles.css">
  <style>
    /* ==============================================
       PORQUESUCEDE — STYLES UNIFICADOS
       Tema: Cosmos Oscuro / Tipografía editorial
       ============================================== */

    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Source+Serif+4:wght@400;600&display=swap');

    /* RESET */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    /* VARIABLES */
    :root {
      --bg:           #0d0d14;
      --bg2:          #13131f;
      --bg3:          #1a1a2e;
      --surface:      #1f1f35;
      --surface2:     #272742;
      --border:       rgba(255,183,77,0.18);
      --border-soft:  rgba(255,255,255,0.06);
      --gold:         #ffb74d;
      --gold-light:   #ffd280;
      --gold-glow:    rgba(255,183,77,0.15);
      --gold-glow2:   rgba(255,183,77,0.08);
      --text:         #e8e8f0;
      --text-muted:   #8888aa;
      --text-faint:   #55556a;
      --font-display: 'Playfair Display', Georgia, serif;
      --font-body:    'Source Serif 4', Georgia, serif;
      --font-mono: 'Courier New', monospace;
      --radius:       10px;
      --radius-lg:    16px;
      --transition:   0.25s ease;
      --shadow:       0 4px 24px rgba(0,0,0,0.4);
      --shadow-gold:  0 0 24px rgba(255,183,77,0.12);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      font-size: 1.05rem;
      line-height: 1.8;
      color: var(--text);
      background: var(--bg);
      min-height: 100vh;
    }

    /* TIPOGRAFÍA */
    h1,h2,h3,h4 { font-family: var(--font-display); line-height:1.25; color:#fff; letter-spacing:-0.01em; }
    h1 { font-size: clamp(1.8rem,4vw,2.8rem); margin-bottom:0.6em; }
    h2 { font-size: clamp(1.4rem,3vw,2rem); margin-bottom:0.5em; }
    h3 { font-size: clamp(1.2rem,2.5vw,1.6rem); margin-bottom:0.4em; }
    h4 { font-size: 1.1rem; margin-bottom:0.3em; }
    p { margin-bottom:1em; }
    strong { color: var(--gold); }

    /* HERO SECTION */
    .hero { 
      padding: 80px 20px 60px; 
      text-align: center; 
      background: linear-gradient(135deg, var(--bg) 0%, var(--bg2) 100%);
      border-bottom: 1px solid var(--border-soft); 
      margin-bottom: 48px;
    }
    .hero h1 { 
      color: var(--gold); 
      margin-bottom: 24px;
      text-shadow: 0 0 20px var(--gold-glow);
    }
    .hero p { 
      font-size: 1.15rem; 
      color: var(--text-muted); 
      max-width: 700px; 
      margin: 0 auto;
      line-height: 1.9;
    }

    /* CONTENEDOR PRINCIPAL */
    .page-wrapper { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
    main { max-width: 900px; margin: 0 auto; }

    /* SECCIONES HOME */
    .home-section { 
      padding: 40px 0; 
      margin-bottom: 32px;
    }
    .home-section h2 {
      color: var(--gold);
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border-soft);
      padding-bottom: 12px;
    }

    /* CATEGORÍAS GRID */
    .categories-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); 
      gap: 20px; 
    }
    .cat-card { 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      justify-content: center;
      padding: 32px 24px; 
      background: var(--surface); 
      border: 1px solid var(--border); 
      border-radius: var(--radius); 
      text-decoration: none; 
      color: var(--text); 
      transition: var(--transition);
      min-height: 160px;
    }
    .cat-card:hover { 
      border-color: var(--gold); 
      transform: translateY(-4px);
      box-shadow: var(--shadow-gold);
    }
    .cat-icon { 
      font-size: 2.5rem; 
      margin-bottom: 16px; 
    }
    .cat-card h3 {
      font-size: 1.1rem;
      margin: 0;
      color: var(--text);
    }

    /* ARTÍCULOS LIST */
    .articles-list { 
      list-style: none; 
      padding: 0;
    }
    .articles-list li { 
      margin-bottom: 16px; 
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-soft);
    }
    .articles-list li:last-child {
      border-bottom: none;
    }
    .articles-list a { 
      color: var(--text); 
      text-decoration: none; 
      transition: var(--transition);
      font-size: 1.05rem;
      display: block;
      padding: 8px 0;
    }
    .articles-list a:hover { 
      color: var(--gold); 
      padding-left: 8px;
    }

    /* AD */
    .ad {
      margin: 48px 0;
      padding: 32px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      text-align: center;
      color: var(--text-muted);
    }

    /* SEO SECTION */
    #seo p {
      color: var(--text-muted);
      line-height: 1.9;
    }

    /* NAVEGACIÓN */
    .navbar { 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      padding: 20px 0; 
      border-bottom: 1px solid var(--border-soft); 
      margin-bottom: 20px;
    }
    .logo { 
      display: flex; 
      align-items: center; 
      gap: 12px; 
      font-family: var(--font-display); 
      font-size: 1.4rem; 
      color: var(--gold); 
      text-decoration: none; 
    }
    .nav-menu { 
      display: flex; 
      gap: 24px; 
      list-style: none; 
    }
    .nav-menu a { 
      color: var(--text); 
      text-decoration: none; 
      transition: var(--transition); 
    }
    .nav-menu a:hover, .nav-menu a.active { 
      color: var(--gold); 
    }

    /* FOOTER */
    footer { 
      text-align: center; 
      padding: 60px 20px; 
      border-top: 1px solid var(--border-soft); 
      margin-top: 80px; 
      background: var(--bg2);
    }
    footer nav { 
      display: flex; 
      justify-content: center; 
      gap: 24px; 
      flex-wrap: wrap; 
      margin-bottom: 24px;
    }
    footer a { 
      color: var(--text-muted); 
      text-decoration: none; 
      transition: var(--transition);
    }
    footer a:hover { 
      color: var(--gold); 
    }
    footer p {
      color: var(--text-faint);
      font-size: 0.9rem;
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      .hero { padding: 60px 20px 40px; }
      .hero h1 { font-size: 2rem; }
      .categories-grid { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
      .cat-card { padding: 24px 16px; min-height: 140px; }
      .nav-menu { gap: 16px; }
      .nav-menu a { font-size: 0.9rem; }
    }
  </style>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/assets/favicon.svg">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsenseId }}" crossorigin="anonymous"></script>
  <meta name="google-adsense-account" content="{{ adsenseId }}">
  
  <script>
    window.adsbygoogle = window.adsbygoogle || [];
  </script>
  
  {# SEO Meta Tags #}
  <meta name="robots" content="index,follow">
  <meta name="googlebot" content="index,follow">
  <meta name="bingbot" content="index,follow">
  
  {# Open Graph #}
  <meta property="og:site_name" content="PorQuéSucede">
  <meta property="og:locale" content="es_ES">
  <meta property="og:type" content="{{ og_type or 'website' }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://porquesucede.com{{ page.url }}">
  <meta property="og:image" content="https://porquesucede.com/assets/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ title }}">
  
  {# Twitter Cards #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://porquesucede.com/assets/og-image.png">
  <meta name="twitter:image:alt" content="{{ title }}">
  
  {# Additional SEO #}
  <meta name="author" content="PorQuéSucede">
  <meta name="language" content="Spanish">
  <meta name="geo.region" content="ES">
  <meta name="rating" content="general">
  <meta name="distribution" content="global">
  
  {# Hreflang for Spanish #}
  <link rel="alternate" hreflang="es" href="https://porquesucede.com{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="https://porquesucede.com{{ page.url }}">
  
  {# Security Headers #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://www.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://pagead2.googlesyndication.com;">
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta http-equiv="X-Frame-Options" content="SAMEORIGIN">
  <meta http-equiv="X-XSS-Protection" content="1; mode=block">
  
  {# JSON-LD Structured Data #}
  <script type="application/ld+json">
  {{ structured_data | safe }}
  </script>
</head>
<body>
  <div class="page-wrapper">
    <header>
      <nav class="navbar">
        <a href="/" class="logo">
          <div class="atom">
            <div class="nucleus"></div>
            <div class="orbit orbit1"></div>
            <div class="orbit orbit2"></div>
            <div class="orbit orbit3"></div>
          </div>
          PorQuéSucede
        </a>
        <ul class="nav-menu">
          <li><a href="/" {% if page.url == '/' %}class="active"{% endif %}>Inicio</a></li>
          <li><a href="/ciencia/" {% if '/ciencia/' in page.url %}class="active"{% endif %}>Ciencia</a></li>
          <li><a href="/cuerpo/" {% if '/cuerpo/' in page.url %}class="active"{% endif %}>Cuerpo</a></li>
          <li><a href="/psicologia/" {% if '/psicologia/' in page.url %}class="active"{% endif %}>Psicología</a></li>
          <li><a href="/animales/" {% if '/animales/' in page.url %}class="active"{% endif %}>Animales</a></li>
          <li><a href="/tecnologia/" {% if '/tecnologia/' in page.url %}class="active"{% endif %}>Tecnología</a></li>
        </ul>
      </nav>
      
      {% if show_search != false %}
      <form id="search-form" class="search-form" role="search">
        <input type="text" id="search-input" placeholder="Buscar artículos..." autocomplete="off" aria-label="Buscar artículos">
        <button type="submit">Buscar</button>
        <div id="search-results" class="search-results"></div>
      </form>
      {% endif %}
      
      {% if breadcrumbs %}
      <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span class="sep">›</span>
        {% for crumb in breadcrumbs %}
          {% if loop.last %}
            <span>{{ crumb.name }}</span>
          {% else %}
            <a href="{{ crumb.url }}">{{ crumb.name }}</a>
            <span class="sep">›</span>
          {% endif %}
        {% endfor %}
      </nav>
      {% endif %}
    </header>

    <main>
      {{ content }}
    </main>

    <footer>
      <p>&copy; {{ year }} PorQuéSucede</p>
      <nav>
        <a href="/sobre-nosotros/">Sobre nosotros</a>
        <a href="/contacto/">Contacto</a>
        <a href="/politica-privacidad/">Privacidad</a>
        <a href="/politica-cookies/">Cookies</a>
        <a href="/terminos/">Términos</a>
      </nav>
    </footer>
  </div>

  <script src="/js/search.js"></script>
</body>
</html>
