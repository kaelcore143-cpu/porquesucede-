<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | PorQuéSucede</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="https://porquesucede.com{{ page.url }}">
  <link rel="stylesheet" href="/styles.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: #0a0a0f;
      color: #e0e0e0;
      line-height: 1.6;
      min-height: 100vh;
    }

    .page-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* NAVEGACIÓN */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 0;
      border-bottom: 1px solid #1a1a2e;
      margin-bottom: 40px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 1.5rem;
      font-weight: 700;
      color: #f59e0b;
      text-decoration: none;
    }

    .atom {
      width: 40px;
      height: 40px;
      position: relative;
    }

    .nucleus {
      width: 12px;
      height: 12px;
      background: #f59e0b;
      border-radius: 50%;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .orbit {
      position: absolute;
      border: 2px solid #f59e0b;
      border-radius: 50%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .orbit1 { width: 30px; height: 30px; }
    .orbit2 { width: 36px; height: 36px; }
    .orbit3 { width: 40px; height: 40px; }

    .nav-menu {
      display: flex;
      gap: 24px;
      list-style: none;
    }

    .nav-menu a {
      color: #a0a0a0;
      text-decoration: none;
      transition: color 0.3s;
    }

    .nav-menu a:hover,
    .nav-menu a.active {
      color: #f59e0b;
    }

    /* BÚSQUEDA */
    .search-form {
      margin-bottom: 40px;
    }

    .search-input {
      width: 100%;
      padding: 12px 16px;
      background: #1a1a2e;
      border: 1px solid #2a2a4e;
      border-radius: 8px;
      color: #e0e0e0;
      font-size: 1rem;
    }

    .search-input:focus {
      outline: none;
      border-color: #f59e0b;
    }

    .search-results {
      position: absolute;
      background: #1a1a2e;
      border: 1px solid #2a2a4e;
      border-radius: 8px;
      max-height: 400px;
      overflow-y: auto;
      z-index: 1000;
      display: none;
    }

    /* HERO SECTION */
    .hero {
      text-align: center;
      padding: 60px 20px;
      background: linear-gradient(135deg, #0a0a0f 0%, #1a1a2e 100%);
      border-radius: 12px;
      margin-bottom: 48px;
    }

    .hero h1 {
      font-size: 2.5rem;
      color: #f59e0b;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 1.1rem;
      color: #a0a0a0;
      max-width: 700px;
      margin: 0 auto;
    }

    .hero strong {
      color: #f59e0b;
    }

    /* HOME SECTIONS */
    .home-section {
      margin-bottom: 48px;
    }

    .home-section h2 {
      font-size: 1.8rem;
      color: #f59e0b;
      margin-bottom: 24px;
      border-bottom: 2px solid #1a1a2e;
      padding-bottom: 12px;
    }

    /* CATEGORÍAS GRID */
    .categories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
    }

    .cat-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 24px;
      background: #1a1a2e;
      border: 1px solid #2a2a4e;
      border-radius: 12px;
      text-decoration: none;
      color: #e0e0e0;
      transition: all 0.3s;
      min-height: 160px;
    }

    .cat-card:hover {
      border-color: #f59e0b;
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(245, 158, 11, 0.15);
    }

    .cat-icon {
      font-size: 2.5rem;
      margin-bottom: 16px;
    }

    /* ARTÍCULOS LIST */
    .articles-list {
      list-style: none;
    }

    .articles-list li {
      margin-bottom: 16px;
      padding-bottom: 16px;
      border-bottom: 1px solid #1a1a2e;
    }

    .articles-list li:last-child {
      border-bottom: none;
    }

    .articles-list a {
      color: #e0e0e0;
      text-decoration: none;
      transition: color 0.3s;
      display: block;
      padding: 8px 0;
    }

    .articles-list a:hover {
      color: #f59e0b;
      padding-left: 8px;
    }

    /* AD */
    .ad {
      margin: 48px 0;
      padding: 32px;
      background: #1a1a2e;
      border: 1px solid #2a2a4e;
      border-radius: 12px;
      text-align: center;
      color: #a0a0a0;
    }

    /* FOOTER */
    footer {
      text-align: center;
      padding: 60px 20px;
      border-top: 1px solid #1a1a2e;
      margin-top: 80px;
      background: #0a0a0f;
    }

    footer nav {
      display: flex;
      justify-content: center;
      gap: 24px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    footer a {
      color: #a0a0a0;
      text-decoration: none;
      transition: color 0.3s;
    }

    footer a:hover {
      color: #f59e0b;
    }

    footer p {
      color: #6a6a8a;
      font-size: 0.9rem;
    }

    /* BREADCRUMB */
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 24px;
      font-size: 0.9rem;
    }

    .breadcrumb a {
      color: #a0a0a0;
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: #f59e0b;
    }

    .breadcrumb .sep {
      color: #2a2a4e;
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      .navbar {
        flex-direction: column;
        gap: 16px;
      }

      .nav-menu {
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
      }

      .hero h1 {
        font-size: 2rem;
      }

      .categories-grid {
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      }

      .cat-card {
        padding: 24px 16px;
        min-height: 140px;
      }
    }
  </style>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/assets/favicon.svg">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsenseId }}" crossorigin="anonymous"></script>
  <meta name="google-adsense-account" content="{{ adsenseId }}">
  
  <script>
    window.adsbygoogle = window.adsbygoogle || [];
  </script>
  
  {# SEO Meta Tags #}
  <meta name="robots" content="index,follow">
  <meta name="googlebot" content="index,follow">
  <meta name="bingbot" content="index,follow">
  
  {# Open Graph #}
  <meta property="og:site_name" content="PorQuéSucede">
  <meta property="og:locale" content="es_ES">
  <meta property="og:type" content="{{ og_type or 'website' }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://porquesucede.com{{ page.url }}">
  <meta property="og:image" content="https://porquesucede.com/assets/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ title }}">
  
  {# Twitter Cards #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://porquesucede.com/assets/og-image.png">
  <meta name="twitter:image:alt" content="{{ title }}">
  
  {# Additional SEO #}
  <meta name="author" content="PorQuéSucede">
  <meta name="language" content="Spanish">
  <meta name="geo.region" content="ES">
  <meta name="rating" content="general">
  <meta name="distribution" content="global">
  
  {# Hreflang for Spanish #}
  <link rel="alternate" hreflang="es" href="https://porquesucede.com{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="https://porquesucede.com{{ page.url }}">
  
  {# Security Headers #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://www.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://pagead2.googlesyndication.com;">
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta http-equiv="X-Frame-Options" content="SAMEORIGIN">
  <meta http-equiv="X-XSS-Protection" content="1; mode=block">
  
  {# JSON-LD Structured Data #}
  <script type="application/ld+json">
  {{ structured_data | safe }}
  </script>
</head>
<body>
  <div class="page-wrapper">
    <header>
      <nav class="navbar">
        <a href="/" class="logo">
          <div class="atom">
            <div class="nucleus"></div>
            <div class="orbit orbit1"></div>
            <div class="orbit orbit2"></div>
            <div class="orbit orbit3"></div>
          </div>
          PorQuéSucede
        </a>
        <ul class="nav-menu">
          <li><a href="/" {% if page.url == '/' %}class="active"{% endif %}>Inicio</a></li>
          <li><a href="/ciencia/" {% if '/ciencia/' in page.url %}class="active"{% endif %}>Ciencia</a></li>
          <li><a href="/cuerpo/" {% if '/cuerpo/' in page.url %}class="active"{% endif %}>Cuerpo</a></li>
          <li><a href="/psicologia/" {% if '/psicologia/' in page.url %}class="active"{% endif %}>Psicología</a></li>
          <li><a href="/animales/" {% if '/animales/' in page.url %}class="active"{% endif %}>Animales</a></li>
          <li><a href="/tecnologia/" {% if '/tecnologia/' in page.url %}class="active"{% endif %}>Tecnología</a></li>
        </ul>
      </nav>
      
      {% if show_search != false %}
      <form id="search-form" class="search-form" role="search">
        <input type="text" id="search-input" placeholder="Buscar artículos..." autocomplete="off" aria-label="Buscar artículos">
        <button type="submit">Buscar</button>
        <div id="search-results" class="search-results"></div>
      </form>
      {% endif %}
      
      {% if breadcrumbs %}
      <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span class="sep">›</span>
        {% for crumb in breadcrumbs %}
          {% if loop.last %}
            <span>{{ crumb.name }}</span>
          {% else %}
            <a href="{{ crumb.url }}">{{ crumb.name }}</a>
            <span class="sep">›</span>
          {% endif %}
        {% endfor %}
      </nav>
      {% endif %}
    </header>

    <main>
      {{ content }}
    </main>

    <footer>
      <p>&copy; {{ year }} PorQuéSucede</p>
      <nav>
        <a href="/sobre-nosotros/">Sobre nosotros</a>
        <a href="/contacto/">Contacto</a>
        <a href="/politica-privacidad/">Privacidad</a>
        <a href="/politica-cookies/">Cookies</a>
        <a href="/terminos/">Términos</a>
      </nav>
    </footer>
  </div>

  <script src="/js/search.js"></script>
</body>
</html>
